rules_version = '2';

// Permanent rules: nothing here expires (unlike Firebase's "test mode", which
// locks the database after 30 days). Everything not listed is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the owner's accounts count as admin (email + password users, created in the Firebase console).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email.lower() in [
          'gabynorris616@gmail.com',
          'gmmnorris@gmail.com',
          'gabriellenor05@gmail.com'
        ];
    }

    // Portfolio projects: anyone can read, only the admin can change.
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact form: anyone can CREATE a well-formed message; only the admin
    // can read, edit or delete them. Visitors can never read other messages.
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'reason', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.matches('.+@.+\\..+')
        && request.resource.data.email.size() <= 200
        && request.resource.data.reason in ['Freelance work', 'Job opportunity', 'Feedback']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // CV requests: anyone can submit one; only the admin can read, update or delete.
    match /cvRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'company', 'email', 'reason', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.company is string && request.resource.data.company.size() > 0 && request.resource.data.company.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.matches('.+@.+\\..+') && request.resource.data.email.size() <= 200
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Counter of unresolved messages (so the site can send a reminder at 5, 10, 15...).
    // Visitors may only add exactly 1; the admin sets it.
    match /meta/unresolved {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
    }
  }
}
